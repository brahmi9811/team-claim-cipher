# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=denialfighter

# --- LLM (optional; agents fall back to heuristics without a key) ---
OPENROUTER_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claim-cipher

# --- PHI encryption (Queryable Encryption / CSFLE) ---
# Local 96-byte master key. Created automatically if missing.
# Never commit this file.
QE_KEY_FILE=./master-key.key
# Path to MongoDB crypt_shared library, if not on the default search path.
CRYPT_SHARED_PATH=

# --- Services ---
SIM_URL=http://localhost:8001
WEB_API_URL=http://localhost:8002
WEB_PORT=8002
SIM_PORT=8001
SIM_HOST=0.0.0.0

# --- Orchestrator ---
CLAIM_RATE_PER_SEC=2
EVOLVER_CYCLE_SECONDS=300
EVOLVER_CYCLE_OUTCOMES=50
APPEAL_POLL_SECONDS=5
MAX_CLAIMS=0
CLAIM_BATCH_SIZE=10
MAX_IN_FLIGHT=20
# DEFAULT_APPEAL_MODE=draft_only   # draft_only (a human clicks Approve) | auto_file; applies to new/reset profiles
# SIM_TIMEOUT_SEC=10               # a slower simulator response counts as unreachable -> local fallback

# --- Optional role-specific Atlas URIs (fall back to MONGODB_URI) ---
# MONGODB_URI_AGENT=
# MONGODB_URI_FIREWALL=
# MONGODB_URI_SIMULATOR=
# MONGODB_URI_SCORER=
# FORGE_MONGODB_URI=

# --- Optional: Embedding API fallback (local all-MiniLM-L6-v2 is preferred) ---
# MONGODB_EMBEDDING_API_KEY=
# VOYAGE_API_KEY=

# --- Demo / ops ---
# SIM_ADMIN_TOKEN=          # if set, required on simulator /admin/*
# DEMO_BUTTON_TOKEN=        # if set, required on live-view button endpoints through a tunnel
# DEMO_RESET_SNAPSHOT=      # path used by the reset button restore
# SMOKE_MONGODB_DB=denialfighter_smoke
# SIM_MODE=real             # real | stub
# SIM_STORE=mongo           # mongo | memory
